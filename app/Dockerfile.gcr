
FROM python:3.12-slim

# TODO: Add frontend build stage to copy built files

ARG USER_ID=1000
ARG GID=1000

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /code/app

# Create non-root user
RUN groupadd -g $GID docker-users && \
    useradd -m --no-log-init -s /bin/bash -u $USER_ID -g $GID docker

# Install Chrome and ChromeDriver for Selenium support
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives

RUN pip install --upgrade pip
COPY ./app/requirements-gcr.txt ./
RUN pip install --no-cache-dir -r requirements-gcr.txt

# Force cache invalidation to pick up latest code
ENV DEPLOY_TIMESTAMP="2026-02-03-Attempt3"
COPY ./app/src ./

RUN chmod +x entrypoint.gcr.sh wait-for-it.sh run_crawler.sh run_email.sh

# Set ownership and permissions
RUN chown -R docker:docker-users /code/app

USER docker

ENTRYPOINT [ "/code/app/entrypoint.gcr.sh" ]

CMD exec gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 8 --timeout 0 config.wsgi:application
