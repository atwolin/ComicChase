# .env.vm example file
# Used for VM + Firebase Hosting deployment
#
# Usage:
# 1. Copy this file to .env.vm
#    cp .env.vm.example .env.vm
#
# 2. Modify the API URL according to your actual deployment
#    VITE_API_BASE_URL=https://your-actual-vm-domain.com/api

# VM API Base URL
VITE_API_BASE_URL=https://api.comicchase.site/api
