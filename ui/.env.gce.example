# .env.gce example file
# Used for GCE + Firebase Hosting deployment
#
# Usage:
# 1. Copy this file to .env.gce
#    cp .env.gce.example .env.gce
#
# 2. Modify the API URL according to your actual deployment
#    VITE_API_BASE_URL=https://your-actual-gce-domain.com/api

# GCE API Base URL
VITE_API_BASE_URL=https://api.comicchase.com.tw/api
